<UserControl x:Class="Tamarillo.Ui.JobCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Tamarillo.Ui"
             Width="{StaticResource Overlay.Width}" RenderTransformOrigin="0.5,1">
    <UserControl.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="CardScale" />
            <TranslateTransform x:Name="CardMove" />
        </TransformGroup>
    </UserControl.RenderTransform>
    <!-- Margin leaves room for the popup shadow inside the transparent overlay window. -->
    <Border x:Name="Card" Style="{StaticResource Tama.Card}" Margin="14,6,14,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Status disc: progress ring → green check / alert. Display only; the corner X closes. -->
            <Grid Width="{StaticResource Overlay.Ring}" Height="{StaticResource Overlay.Ring}" VerticalAlignment="Center">
                <Grid x:Name="Running">
                    <Ellipse Stroke="{StaticResource Brush.Surface4}" StrokeThickness="{StaticResource Overlay.RingStroke}" Margin="1.5" />
                    <Path x:Name="Arc" Stroke="{StaticResource Brush.Accent}" StrokeThickness="{StaticResource Overlay.RingStroke}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="ArcSpin" />
                        </Path.RenderTransform>
                    </Path>
                    <ui:IconView x:Name="ActionIcon" Width="16" Height="16" Foreground="{StaticResource Brush.Text.Secondary}" />
                </Grid>
                <Grid x:Name="DoneDisc" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="DoneScale" />
                    </Grid.RenderTransform>
                    <Ellipse Fill="{StaticResource Brush.Success}" />
                    <ui:IconView Icon="Icon.Check" Width="20" Height="20" StrokeThickness="2.4" Foreground="{StaticResource Brush.Canvas}" />
                </Grid>
                <Grid x:Name="FailedDisc" Visibility="Collapsed">
                    <Ellipse Fill="{StaticResource Brush.Danger.Soft}" />
                    <ui:IconView Icon="Icon.Alert" Width="20" Height="20" Foreground="{StaticResource Brush.Danger}" />
                </Grid>
            </Grid>

            <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center">
                <Button x:Name="TitleLink" Style="{StaticResource Tama.Link}" Click="OnOpen" IsHitTestVisible="False">
                    <TextBlock x:Name="TitleText" Style="{StaticResource Text.BodyStrong}" />
                </Button>
                <Button x:Name="DetailLink" Style="{StaticResource Tama.Link}" Click="OnReveal" IsHitTestVisible="False" Margin="0,2,0,0">
                    <TextBlock x:Name="DetailText" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" />
                </Button>
            </StackPanel>

            <!-- Pulled into the card's top-right corner (past the card padding). -->
            <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource Tama.RoundButton}"
                    Width="{StaticResource Overlay.Close}" Height="{StaticResource Overlay.Close}"
                    VerticalAlignment="Top" Margin="0,-6,-6,0" ToolTip="Cancelar" Click="OnClose">
                <ui:IconView Icon="Icon.Close" Width="{StaticResource Overlay.CloseIcon}" Height="{StaticResource Overlay.CloseIcon}"
                             Foreground="{StaticResource Brush.Text.Tertiary}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
