<UserControl x:Class="Tamarillo.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tui="clr-namespace:Tamarillo.Ui"
             xmlns:views="clr-namespace:Tamarillo.Views">
    <!-- Module page inside the host. Cards on the content surface; never nested. -->
    <ScrollViewer Padding="28,8,28,28">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

            <!-- Hero -->
            <Border Style="{StaticResource Card}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{StaticResource Brand.Logo}" Width="64" Height="64" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Margin="20,2,16,0">
                        <TextBlock Text="Arraste, segure, solte." Style="{StaticResource Text.Title}" />
                        <TextBlock Style="{StaticResource Text.Paragraph}" Margin="0,8,0,0" MaxWidth="560" HorizontalAlignment="Left">
                            Segure o atalho enquanto arrasta arquivos: uma roda aparece com o que dá para fazer com eles.
                            Solte sobre a ação e o resultado aparece ao lado do original. Tudo roda neste computador.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="Atalho" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <views:Keycaps x:Name="HeroKeys" />
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="StatusChip" Grid.Column="2" Style="{StaticResource Chip}" VerticalAlignment="Top" Padding="9,0" Height="24">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock x:Name="StatusText" FontSize="{StaticResource FontSize.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- How to -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Como usar" Style="{StaticResource Text.Overline}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <Grid Width="40" Height="40" HorizontalAlignment="Left">
                                <Ellipse Fill="{StaticResource Brush.Surface3}" />
                                <tui:IconView Icon="Icon.Files" Width="20" Height="20" Foreground="{StaticResource Brush.Text.Primary}" />
                            </Grid>
                            <TextBlock Text="1  Arraste" Style="{StaticResource Text.BodyStrong}" Margin="0,12,0,0" />
                            <TextBlock Style="{StaticResource Text.Paragraph}" Margin="0,4,0,0"
                                       Text="Comece a arrastar arquivos ou pastas do Explorador ou da área de trabalho." />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid Width="40" Height="40" HorizontalAlignment="Left">
                                <Ellipse Fill="{StaticResource Brush.Surface3}" />
                                <Image Source="{StaticResource Brand.Mark}" Width="26" Height="26" />
                            </Grid>
                            <TextBlock x:Name="StepHold" Text="2  Segure o atalho" Style="{StaticResource Text.BodyStrong}" TextWrapping="Wrap" Margin="0,12,0,0" />
                            <TextBlock Style="{StaticResource Text.Paragraph}" Margin="0,4,0,0"
                                       Text="A roda aparece sob o cursor, só com as opções que servem para esses arquivos." />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <Grid Width="40" Height="40" HorizontalAlignment="Left">
                                <Ellipse Fill="{StaticResource Brush.Accent.Soft}" />
                                <tui:IconView Icon="Icon.Check" Width="20" Height="20" Foreground="{StaticResource Brush.Accent}" />
                            </Grid>
                            <TextBlock Text="3  Solte na ação" Style="{StaticResource Text.BodyStrong}" Margin="0,12,0,0" />
                            <TextBlock Style="{StaticResource Text.Paragraph}" Margin="0,4,0,0"
                                       Text="Aponte e solte. Opções com um ponto abrem mais escolhas. Solte no centro para cancelar." />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SelectionTip" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,18,0,0"
                               Text="Sem arrastar: selecione arquivos no Explorador, segure o atalho, aponte para a ação e solte as teclas." />
                </StackPanel>
            </Border>

            <!-- Try it -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Experimente" Style="{StaticResource Text.Overline}" />
                    <Border x:Name="DropZone" Margin="0,12,0,0" Height="128" CornerRadius="{StaticResource Radius.Md}"
                            Background="{StaticResource Brush.Surface3}" AllowDrop="True"
                            DragEnter="OnZoneDragEnter" DragOver="OnZoneDragOver" DragLeave="OnZoneDragLeave" Drop="OnZoneDrop">
                        <Grid>
                            <Border x:Name="DropGlow" CornerRadius="{StaticResource Radius.Md}" Background="{StaticResource Brush.Accent.Soft}" Opacity="0" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <tui:IconView x:Name="DropIcon" Icon="Icon.Files" Width="24" Height="24" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                <TextBlock Text="Solte arquivos aqui para abrir a roda" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                <TextBlock Text="Nada é alterado até você escolher uma ação." Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Capabilities -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Neste computador" Style="{StaticResource Text.Overline}" VerticalAlignment="Center" />
                        <TextBlock x:Name="DetectingText" Text="Verificando…" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl x:Name="Engines" Margin="0,6,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="36" Height="36" VerticalAlignment="Center">
                                        <Ellipse Fill="{StaticResource Brush.Surface3}" />
                                        <tui:IconView Icon="{Binding Icon}" Width="18" Height="18" Foreground="{StaticResource Brush.Text.Secondary}" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.BodyStrong}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource Chip}" Background="{Binding ChipBackground}" Padding="9,0" Height="22" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" Fill="{Binding ChipForeground}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding ChipForeground}" FontSize="{StaticResource FontSize.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
